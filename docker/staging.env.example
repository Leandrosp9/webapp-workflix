# Copy to a private environment file and rotate every placeholder before use.
APP_ENV=staging
DEMO_MODE=false

POSTGRES_DB=workflix
POSTGRES_USER=workflix
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://workflix:replace-with-a-long-random-password@postgres:5432/workflix

# Portable smoke tests may set env; real staging defaults to AWS Secrets Manager.
SECRETS_MANAGER_PROVIDER=aws
AWS_SECRET_ID=workflix/staging/application
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Leave JWT_SECRET empty when it is supplied by AWS Secrets Manager.
JWT_SECRET=

MINIO_ROOT_USER=workflix-staging
MINIO_ROOT_PASSWORD=replace-with-at-least-16-random-characters
S3_BUCKET=workflix-staging
MAX_AVATAR_SIZE_MB=5

RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_AI_PER_MINUTE=10

RAG_EMBEDDING_MODEL=gemini-embedding-2
RAG_EMBEDDING_DIMENSIONS=768
RAG_MAX_PDF_PAGES=500
RAG_OCR_ENABLED=true
RAG_OCR_LANGUAGES=por+eng
RAG_OCR_DPI=200
RAG_OCR_MIN_NATIVE_CHARS=1
RAG_OCR_MAX_PAGES=100
RAG_RETRIEVAL_LIMIT=6
DOCUMENT_WORKER_POLL_SECONDS=1
DOCUMENT_JOB_LEASE_SECONDS=120
DOCUMENT_JOB_HEARTBEAT_SECONDS=30
DOCUMENT_JOB_MAX_ATTEMPTS=5
DOCUMENT_JOB_RETRY_BASE_SECONDS=10
DOCUMENT_JOB_RETRY_MAX_SECONDS=300

BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
