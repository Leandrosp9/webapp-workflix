# Application
APP_NAME=Workflix API
APP_ENV=development
APP_DEBUG=false
APP_VERSION=0.1.0
DEMO_MODE=true
LOG_LEVEL=INFO

# Browser origins, comma-separated
CORS_ORIGINS=http://localhost:5173

# PostgreSQL / pgvector
POSTGRES_DB=workflix
POSTGRES_USER=workflix
POSTGRES_PASSWORD=workflix
DATABASE_URL=postgresql+psycopg://workflix:workflix@postgres:5432/workflix

# Authentication (replace before any non-local deployment)
JWT_SECRET=change-me-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# Cloud AI providers (optional until the AI phase)
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
RAG_EMBEDDING_MODEL=gemini-embedding-2
RAG_EMBEDDING_DIMENSIONS=768
RAG_MAX_PDF_PAGES=500
RAG_RETRIEVAL_LIMIT=6
DOCUMENT_WORKER_POLL_SECONDS=1
DOCUMENT_JOB_LEASE_SECONDS=120
DOCUMENT_JOB_HEARTBEAT_SECONDS=30
DOCUMENT_JOB_MAX_ATTEMPTS=5
DOCUMENT_JOB_RETRY_BASE_SECONDS=10
DOCUMENT_JOB_RETRY_MAX_SECONDS=300
GROQ_API_KEY=
GROQ_MODEL=

# Files (local is intended for development only)
FILE_STORAGE_PROVIDER=local
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIRECTORY=uploads
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=

# Request protection (Redis is required by the staging overlay)
RATE_LIMIT_PROVIDER=memory
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_AI_PER_MINUTE=10
TRUST_PROXY_HEADERS=false

# Managed secrets (the staging overlay defaults to aws)
SECRETS_MANAGER_PROVIDER=env
AWS_SECRET_ID=
AWS_REGION=us-east-1
AWS_SECRETS_ENDPOINT_URL=

# Frontend build-time configuration
VITE_API_BASE_URL=/api/v1
FRONTEND_PORT=5173
